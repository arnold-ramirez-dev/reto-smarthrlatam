# Local backend configuration. Never commit real credentials.
DATABASE_URL=jdbc:h2:mem:alertoperations;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
FRONTEND_ORIGIN=http://localhost:3000

# Leave empty locally. In AWS, set this to the exact Secrets Manager ARN.
DB_SECRET_ARN=
AWS_REGION=us-east-1

